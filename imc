    let plataformas=[], lavas=[], aguas=[], espinhos=[];
    let botoes=[], portasMoveis=[], diamantes=[];
    let saidaFogo=null, saidaAgua=null;
    let fogoNaSaida=false, aguaNaSaida=false;
    let spawnF={x:40,y:450}, spawnA={x:100,y:450};

    function colide(a,b){
      return a.x<b.x+b.w && a.x+a.w>b.x && a.y<b.y+b.h && a.y+a.h>b.y;
    }

    function mostrarMsg(t){
      const el=document.getElementById('msg');
      el.textContent=t;
      clearTimeout(msgTimer);
      msgTimer=setTimeout(()=>el.textContent='',2400);
    }

    function spawnParticula(x,y,cor){
      for(let i=0;i<8;i++){
        particulas.push({
          x,y,
          vx:(Math.random()-0.5)*4,
          vy:(Math.random()-0.5)*4-2,
          vida:30+Math.random()*20,
          cor,
          r:2+Math.random()*3
        });
      }
    }

    function carregarFase(n){
      const f=fases[n];
      plataformas=f.plataformas.map(p=>({...p}));
      lavas=f.lava.map(l=>({...l}));
      aguas=f.agua.map(a=>({...a}));
      espinhos=f.espinhos.map(e=>({...e}));
      botoes=f.botoes.map(b=>({...b,ativo:false}));
      portasMoveis=f.portasMoveis.map(p=>({...p,aberta:false,y:p.yFechado}));
      diamantes=f.diamantes.map(d=>({...d,coletado:false}));
      saidaFogo={...f.saidaFogo};
      saidaAgua={...f.saidaAgua};
      spawnF={x:f.spawnFogo.x,y:f.spawnFogo.y};
      spawnA={x:f.spawnAgua.x,y:f.spawnAgua.y};
      fogo.x=spawnF.x; fogo.y=spawnF.y; fogo.vx=0; fogo.vy=0; fogo.vivo=true;
      agua.x=spawnA.x; agua.y=spawnA.y; agua.vx=0; agua.vy=0; agua.vivo=true;
      fogoNaSaida=false; aguaNaSaida=false;
      particulas=[];
      document.getElementById('fase').textContent=(n+1);
      mostrarMsg(`Fase ${n+1}: ${f.nome}`);
    }

    function reviver(quem){
      if(quem==='fogo'){
        fogo.x=spawnF.x; fogo.y=spawnF.y; fogo.vx=0; fogo.vy=0; fogo.vivo=true;
        fogoNaSaida=false;
        spawnParticula(spawnF.x+11,spawnF.y+16,'#f97316');
      } else {
        agua.x=spawnA.x; agua.y=spawnA.y; agua.vx=0; agua.vy=0; agua.vivo=true;
        aguaNaSaida=false;
        spawnParticula(spawnA.x+11,spawnA.y+16,'#38bdf8');
      }
    }

    function iniciar(){
      document.getElementById('tela-inicio').style.display='none';
      document.getElementById('tela-fim').style.display='none';
      faseAtual=0; diamantesFogo=0; diamantesAgua=0;
      atualizarUI(); carregarFase(0);
      jogoAtivo=true; requestAnimationFrame(loop);
    }

    function reiniciar(){
      document.getElementById('tela-fim').style.display='none';
      iniciar();
    }

    function atualizarUI(){
      document.getElementById('dFogo').textContent=diamantesFogo;
      document.getElementById('dAgua').textContent=diamantesAgua;
    }

    function atualizarPersonagem(p,esq,dir,pulo){
      if(!p.vivo) return;
      const vel=4;
      p.vx=0;
      if(teclas[esq]) p.vx=-vel;
      if(teclas[dir]) p.vx=vel;
      if(teclas[pulo]&&p.noChao){ p.vy=-12.8; p.noChao=false; }
      p.vy+=0.5;
      if(p.vy>14) p.vy=14;
      p.x+=p.vx; p.y+=p.vy;

      p.noChao=false;
      for(const pl of plataformas){
        if(colide(p,pl)){
          if(p.vy>0 && p.y+p.h-p.vy<=pl.y+5){
            p.y=pl.y-p.h; p.vy=0; p.noChao=true;
          } else if(p.vx>0 && p.x+p.w-p.vx<=pl.x){
            p.x=pl.x-p.w; p.vx=0;
          } else if(p.vx<0 && p.x-p.vx>=pl.x+pl.w){
            p.x=pl.x+pl.w; p.vx=0;
          } else if(p.vy<0){
            p.y=pl.y+pl.h; p.vy=0;
          }
        }
      }
      for(const po of portasMoveis){
        if(!po.aberta && colide(p,po)){
          if(p.vx>0) p.x=po.x-p.w;
          else if(p.vx<0) p.x=po.x+po.w;
          p.vx=0;
        }
      }
      if(p.x<0) p.x=0;
      if(p.x+p.w>W) p.x=W-p.w;
      if(p.y>H+50){
        p.vivo=false;
        mostrarMsg(p===fogo?'🔥 Fogo caiu! Revivendo...':'💧 Água caiu! Revivendo...');
        setTimeout(()=>reviver(p===fogo?'fogo':'agua'),800);
      }
    }

    function atualizar(){
      if(!jogoAtivo) return;
      tempo++;
      atualizarPersonagem(fogo,'KeyA','KeyD','KeyW');
      atualizarPersonagem(agua,'ArrowLeft','ArrowRight','ArrowUp');

      // Lava: Fogo anda em cima, Água morre (só ela revive)
      for(const l of lavas){
        if(fogo.vivo && colide(fogo,l)){
          if(fogo.vy>=0 && fogo.y+fogo.h-fogo.vy<=l.y+8){
            fogo.y=l.y-fogo.h; fogo.vy=0; fogo.noChao=true;
          }
        }
        if(agua.vivo && colide(agua,l)){
          agua.vivo=false;
          spawnParticula(agua.x+11,agua.y+16,'#38bdf8');
          mostrarMsg('💧 Água morreu na lava! Revivendo...');
          setTimeout(()=>reviver('agua'),800);
        }
      }
      // Água: Água anda em cima, Fogo morre (só ele revive)
      for(const a of aguas){
        if(agua.vivo && colide(agua,a)){
          if(agua.vy>=0 && agua.y+agua.h-agua.vy<=a.y+8){
            agua.y=a.y-agua.h; agua.vy=0; agua.noChao=true;
          }
        }
        if(fogo.vivo && colide(fogo,a)){
          fogo.vivo=false;
          spawnParticula(fogo.x+11,fogo.y+16,'#f97316');
          mostrarMsg('🔥 Fogo morreu na água! Revivendo...');
          setTimeout(()=>reviver('fogo'),800);
        }
      }
      for(const e of espinhos){
        if(fogo.vivo && colide(fogo,e)){
          fogo.vivo=false;
          spawnParticula(fogo.x+11,fogo.y+16,'#f97316');
          mostrarMsg('🔥 Fogo morreu nos espinhos! Revivendo...');
          setTimeout(()=>reviver('fogo'),800);
        }
        if(agua.vivo && colide(agua,e)){
          agua.vivo=false;
          spawnParticula(agua.x+11,agua.y+16,'#38bdf8');
          mostrarMsg('💧 Água morreu nos espinhos! Revivendo...');
          setTimeout(()=>reviver('agua'),800);
        }
      }

      for(const b of botoes){
        b.ativo=(fogo.vivo&&colide(fogo,b))||(agua.vivo&&colide(agua,b));
      }
      for(const po of portasMoveis){
        const botao=botoes.find(b=>b.id===po.id);
        po.aberta=botao&&botao.ativo;
        const alvo=po.aberta?po.yAberto:po.yFechado;
        po.y+=(alvo-po.y)*0.18;
      }

      for(const d of diamantes){
        if(d.coletado) continue;
        if(d.tipo==='fogo'&&fogo.vivo&&colide(fogo,{x:d.x-12,y:d.y-12,w:24,h:24})){
          d.coletado=true; diamantesFogo++;
          spawnParticula(d.x,d.y,'#f97316'); atualizarUI();
        }
        if(d.tipo==='agua'&&agua.vivo&&colide(agua,{x:d.x-12,y:d.y-12,w:24,h:24})){
          d.coletado=true; diamantesAgua++;
          spawnParticula(d.x,d.y,'#38bdf8'); atualizarUI();
        }
      }

      // Partículas
      for(let i=particulas.length-1;i>=0;i--){
        const p=particulas[i];
        p.x+=p.vx; p.y+=p.vy; p.vy+=0.15; p.vida--;
        if(p.vida<=0) particulas.splice(i,1);
      }

      fogoNaSaida=fogo.vivo&&colide(fogo,saidaFogo);
      aguaNaSaida=agua.vivo&&colide(agua,saidaAgua);

      if(fogoNaSaida&&aguaNaSaida){
        if(faseAtual<fases.length-1){
          faseAtual++;
          carregarFase(faseAtual);
        } else {
          fimDeJogo(true);
        }
      }
    }

    function fimDeJogo(vitoria){
      jogoAtivo=false;
      document.getElementById('titulo-fim').textContent=vitoria?'🏆 Vocês Venceram!':'Game Over';
      document.getElementById('texto-fim').textContent=vitoria
        ?`Incrível! Completaram as ${fases.length} fases!\nDiamantes 🔥 ${diamantesFogo} · 💧 ${diamantesAgua}`
        :'Tente novamente!';
      document.getElementById('tela-fim').style.display='flex';
    }

    function desenharPersonagem(p, tipo){
      if(!p.vivo) return;
      const px=p.x+p.w/2;
      // Sombra
      ctx.fillStyle='rgba(0,0,0,0.3)';
      ctx.beginPath();
      ctx.ellipse(px, p.y+p.h+2, 7, 2.5, 0, 0, Math.PI*2);
      ctx.fill();

      ctx.lineWidth=2;
      ctx.strokeStyle='#000';

      if(tipo==='fogo'){
        // === FIREBOY (magro, chama) ===
        // Corpo fino
        ctx.fillStyle='#ff3300';
        ctx.beginPath();
        ctx.moveTo(px, p.y+2);
        // lado esquerdo da chama
        ctx.quadraticCurveTo(px-8, p.y+6, px-9, p.y+14);
        ctx.quadraticCurveTo(px-10, p.y+22, px-7, p.y+28);
        ctx.lineTo(px-5, p.y+p.h-4);
        // pés
        ctx.lineTo(px-2, p.y+p.h);
        ctx.lineTo(px+2, p.y+p.h);
        ctx.lineTo(px+5, p.y+p.h-4);
        // lado direito
        ctx.quadraticCurveTo(px+7, p.y+28, px+10, p.y+22);
        ctx.quadraticCurveTo(px+9, p.y+14, px+8, p.y+6);
        ctx.quadraticCurveTo(px+4, p.y, px, p.y+2);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Chama amarela interna
        ctx.fillStyle='#ffcc00';
        ctx.beginPath();
        ctx.moveTo(px, p.y+6);
        ctx.quadraticCurveTo(px-5, p.y+12, px-4, p.y+20);
        ctx.quadraticCurveTo(px, p.y+18, px+4, p.y+20);
        ctx.quadraticCurveTo(px+5, p.y+12, px, p.y+6);
        ctx.fill();

        // Ponta da chama
        ctx.fillStyle='#ff6600';
        ctx.beginPath();
        ctx.moveTo(px, p.y);
        ctx.lineTo(px-4, p.y+8);
        ctx.lineTo(px, p.y+5);
        ctx.lineTo(px+4, p.y+8);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Olhos amarelos grandes
        ctx.fillStyle='#ffe566';
        ctx.beginPath();
        ctx.arc(px-4, p.y+14, 4.5, 0, Math.PI*2);
        ctx.arc(px+4, p.y+14, 4.5, 0, Math.PI*2);
        ctx.fill();
        ctx.stroke();
        // Pupilas
        ctx.fillStyle='#000';
        ctx.beginPath();
        ctx.arc(px-3.5, p.y+14.5, 2.2, 0, Math.PI*2);
        ctx.arc(px+4.5, p.y+14.5, 2.2, 0, Math.PI*2);
        ctx.fill();

        // Sorriso
        ctx.beginPath();
        ctx.arc(px, p.y+20, 3.5, 0.15, Math.PI-0.15);
        ctx.stroke();

        // Braços finos
        ctx.fillStyle='#ff3300';
        ctx.beginPath();
        ctx.ellipse(px-10, p.y+22, 3.5, 5, -0.4, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(px+10, p.y+22, 3.5, 5, 0.4, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();

        // Pernas finas
        ctx.beginPath();
        ctx.ellipse(px-4, p.y+p.h-1, 3.5, 4, 0, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(px+4, p.y+p.h-1, 3.5, 4, 0, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();

      } else {
        // === WATERGIRL (magra, gota) ===
        ctx.fillStyle='#3399ff';
        // Corpo de gota fino
        ctx.beginPath();
        ctx.moveTo(px, p.y+2);
        ctx.bezierCurveTo(px-11, p.y+8, px-11, p.y+24, px-6, p.y+p.h-4);
        ctx.lineTo(px-2, p.y+p.h);
        ctx.lineTo(px+2, p.y+p.h);
        ctx.lineTo(px+6, p.y+p.h-4);
        ctx.bezierCurveTo(px+11, p.y+24, px+11, p.y+8, px, p.y+2);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Brilho
        ctx.fillStyle='#99ddff';
        ctx.beginPath();
        ctx.ellipse(px-3, p.y+10, 3, 6, -0.2, 0, Math.PI*2);
        ctx.fill();

        // Cabelo/ondulação de água no topo
        ctx.fillStyle='#66bbff';
        ctx.beginPath();
        ctx.moveTo(px-6, p.y+5);
        ctx.quadraticCurveTo(px-10, p.y-4, px-2, p.y);
        ctx.quadraticCurveTo(px+2, p.y-6, px+6, p.y+1);
        ctx.quadraticCurveTo(px+10, p.y-3, px+7, p.y+6);
        ctx.fill();
        ctx.stroke();

        // Olhos
        ctx.fillStyle='#fff';
        ctx.beginPath();
        ctx.arc(px-4, p.y+14, 4.5, 0, Math.PI*2);
        ctx.arc(px+4, p.y+14, 4.5, 0, Math.PI*2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle='#000';
        ctx.beginPath();
        ctx.arc(px-3.5, p.y+14.5, 2.2, 0, Math.PI*2);
        ctx.arc(px+4.5, p.y+14.5, 2.2, 0, Math.PI*2);
        ctx.fill();

        // Sorriso
        ctx.beginPath();
        ctx.arc(px, p.y+20, 3.5, 0.15, Math.PI-0.15);
        ctx.stroke();

        // Braços finos
        ctx.fillStyle='#3399ff';
        ctx.beginPath();
        ctx.ellipse(px-10, p.y+22, 3.5, 5, -0.4, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(px+10, p.y+22, 3.5, 5, 0.4, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();

        // Pernas finas
        ctx.beginPath();
        ctx.ellipse(px-4, p.y+p.h-1, 3.5, 4, 0, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(px+4, p.y+p.h-1, 3.5, 4, 0, 0, Math.PI*2);
        ctx.fill(); ctx.stroke();
      }

      // Partículas leves
      if(tempo%6===0){
        if(tipo==='fogo'){
          particulas.push({x:px+(Math.random()-0.5)*8, y:p.y+2, vx:(Math.random()-0.5)*1, vy:-1.2-Math.random(), vida:16, cor:'#ffcc00', r:2});
        } else {
          particulas.push({x:px+(Math.random()-0.5)*6, y:p.y+4, vx:(Math.random()-0.5)*0.5, vy:0.4, vida:12, cor:'#99ddff', r:1.5});
        }
      }
    }

    function desenhar(){
      // Fundo templo de pedra (qualidade melhor)
      const bgGrad=ctx.createLinearGradient(0,0,0,H);
      bgGrad.addColorStop(0,'#5c4030');
      bgGrad.addColorStop(0.4,'#4a3226');
      bgGrad.addColorStop(1,'#2e1f16');
      ctx.fillStyle=bgGrad;
      ctx.fillRect(0,0,W,H);

      // Blocos de pedra nas paredes
      for(let by=0; by<H; by+=36){
        for(let bx=-20; bx<W+20; bx+=52){
          const off=(Math.floor(by/36)%2)*26;
          const tom=(((bx+off)+by*3)%3);
          ctx.fillStyle=tom===0?'#6b4f3a':(tom===1?'#5a4030':'#4e3728');
          ctx.fillRect(bx+off, by, 50, 34);
          ctx.strokeStyle='rgba(30,20,12,0.5)';
          ctx.lineWidth=1;
          ctx.strokeRect(bx+off+0.5, by+0.5, 50, 34);
          // Detalhe de pedra
          if((bx+by)%150<40){
            ctx.fillStyle='rgba(0,0,0,0.12)';
            ctx.fillRect(bx+off+8, by+8, 12, 8);
          }
        }
      }

      // Vinhas decorativas
      for(let i=0;i<30;i++){
        const vx=(i*127+55)%W;
        const vy=(i*71+20)%(H-80);
        ctx.strokeStyle='#1b4d1a';
        ctx.lineWidth=2.5;
        ctx.beginPath();
        ctx.moveTo(vx, vy);
        ctx.quadraticCurveTo(vx+8, vy+18, vx-4, vy+35);
        ctx.quadraticCurveTo(vx-10, vy+50, vx+2, vy+60);
        ctx.stroke();
        // Folhas
        const folhas=[[6,4],[18,12],[30,8],[45,20]];
        for(const [fy,fx] of folhas){
          ctx.fillStyle=i%2===0?'#3d8c3a':'#2e7d32';
          ctx.beginPath();
          ctx.ellipse(vx+fx, vy+fy, 7, 3.5, (fx%2===0?0.4:-0.35), 0, Math.PI*2);
          ctx.fill();
          ctx.fillStyle='#66bb6a';
          ctx.beginPath();
          ctx.ellipse(vx+fx-1, vy+fy-1, 3, 1.5, 0.3, 0, Math.PI*2);
          ctx.fill();
        }
      }

      // Plataformas de pedra premium
      for(const p of plataformas){
        // Sombra
        ctx.fillStyle='rgba(0,0,0,0.45)';
        ctx.fillRect(p.x+5, p.y+5, p.w, p.h);
        // Corpo
        const pg=ctx.createLinearGradient(p.x, p.y, p.x, p.y+p.h);
        pg.addColorStop(0,'#c4a574');
        pg.addColorStop(0.3,'#a88b5e');
        pg.addColorStop(1,'#7a6344');
        ctx.fillStyle=pg;
        ctx.fillRect(p.x, p.y, p.w, p.h);
        // Divisões de bloco
        ctx.strokeStyle='rgba(80,60,40,0.45)';
        ctx.lineWidth=1;
        for(let bx=0; bx<p.w; bx+=24){
          ctx.beginPath();
          ctx.moveTo(p.x+bx, p.y);
          ctx.lineTo(p.x+bx, p.y+p.h);
          ctx.stroke();
        }
        // Topo iluminado
        ctx.fillStyle='#d4bc8e';
        ctx.fillRect(p.x, p.y, p.w, 4);
        // Borda
        ctx.strokeStyle='#5c4a32';
        ctx.lineWidth=1.5;
        ctx.strokeRect(p.x+0.5, p.y+0.5, p.w-1, p.h-1);
        // Musgo no topo
        ctx.fillStyle='#4caf50';
        for(let mx=6; mx<p.w-6; mx+=14){
          ctx.beginPath();
          ctx.ellipse(p.x+mx, p.y+1, 6, 3.5, 0, 0, Math.PI*2);
          ctx.fill();
        }
        ctx.fillStyle='#81c784';
        for(let mx=10; mx<p.w-8; mx+=18){
          ctx.beginPath();
          ctx.ellipse(p.x+mx, p.y, 4, 2.5, 0, 0, Math.PI*2);
          ctx.fill();
        }
        // Vinhas penduradas
        if(p.w>50 && p.y<460){
          ctx.strokeStyle='#2e7d32';
          ctx.lineWidth=2;
          ctx.beginPath();
          ctx.moveTo(p.x+8, p.y+p.h);
          ctx.quadraticCurveTo(p.x+2, p.y+p.h+14, p.x+12, p.y+p.h+28);
          ctx.stroke();
          if(p.w>90){
            ctx.beginPath();
            ctx.moveTo(p.x+p.w-10, p.y+p.h);
            ctx.quadraticCurveTo(p.x+p.w-2, p.y+p.h+12, p.x+p.w-16, p.y+p.h+26);
            ctx.stroke();
          }
          ctx.fillStyle='#43a047';
          ctx.beginPath();
          ctx.ellipse(p.x+10, p.y+p.h+20, 5, 3, 0.5, 0, Math.PI*2);
          ctx.fill();
          if(p.w>90){
            ctx.beginPath();
            ctx.ellipse(p.x+p.w-12, p.y+p.h+18, 5, 3, -0.4, 0, Math.PI*2);
            ctx.fill();
          }
        }
      }

      // Lava animada
      for(const l of lavas){
        const lg=ctx.createLinearGradient(l.x,l.y,l.x,l.y+l.h);
        lg.addColorStop(0,'#fbbf24');
        lg.addColorStop(0.4,'#f97316');
        lg.addColorStop(1,'#c2410c');
        ctx.fillStyle=lg;
        ctx.fillRect(l.x,l.y,l.w,l.h);
        // Bolhas
        ctx.fillStyle='rgba(254,243,199,0.7)';
        for(let i=0;i<l.w;i+=14){
          const by=l.y+4+Math.sin(tempo*0.1+i)*3;
          ctx.beginPath();
          ctx.arc(l.x+i+7,by,4+Math.sin(tempo*0.08+i)*1.5,0,Math.PI*2);
          ctx.fill();
        }
        // Brilho topo
        ctx.fillStyle='rgba(254,243,199,0.4)';
        ctx.fillRect(l.x,l.y,l.w,3);
      }

      // Água animada
      for(const a of aguas){
        const ag=ctx.createLinearGradient(a.x,a.y,a.x,a.y+a.h);
        ag.addColorStop(0,'#7dd3fc');
        ag.addColorStop(0.5,'#0ea5e9');
        ag.addColorStop(1,'#0369a1');
        ctx.fillStyle=ag;
        ctx.fillRect(a.x,a.y,a.w,a.h);
        ctx.fillStyle='rgba(224,242,254,0.6)';
        for(let i=0;i<a.w;i+=16){
          const by=a.y+5+Math.sin(tempo*0.08+i*0.5)*2;
          ctx.beginPath();
          ctx.arc(a.x+i+8,by,3.5,0,Math.PI*2);
          ctx.fill();
        }
        ctx.fillStyle='rgba(224,242,254,0.35)';
        ctx.fillRect(a.x,a.y,a.w,3);
      }

      // Espinhos
      for(const e of espinhos){
        ctx.fillStyle='#cbd5e1';
        for(let i=0;i<e.w;i+=9){
          ctx.beginPath();
          ctx.moveTo(e.x+i, e.y+e.h);
          ctx.lineTo(e.x+i+4.5, e.y);
          ctx.lineTo(e.x+i+9, e.y+e.h);
          ctx.fill();
        }
        ctx.fillStyle='#64748b';
        ctx.fillRect(e.x, e.y+e.h-3, e.w, 3);
      }

      // Botões
      for(const b of botoes){
        ctx.fillStyle=b.ativo?'#4ade80':'#ef4444';
        ctx.shadowColor=b.ativo?'#4ade80':'#ef4444';
        ctx.shadowBlur=b.ativo?12:0;
        ctx.beginPath();
        ctx.roundRect(b.x,b.y,b.w,b.h,3);
        ctx.fill();
        ctx.shadowBlur=0;
        ctx.fillStyle='rgba(255,255,255,0.5)';
        ctx.fillRect(b.x+4,b.y+2,b.w-8,3);
      }

      // Portas móveis
      for(const po of portasMoveis){
        const cor=po.aberta?'#86efac':'#f87171';
        ctx.fillStyle=cor;
        ctx.shadowColor=cor;
        ctx.shadowBlur=8;
        ctx.beginPath();
        ctx.roundRect(po.x,po.y,po.w,po.h,3);
        ctx.fill();
        ctx.shadowBlur=0;
        ctx.fillStyle='rgba(255,255,255,0.4)';
        ctx.fillRect(po.x+3,po.y+8,po.w-6,po.h-16);
      }

      // Diamantes
      for(const d of diamantes){
        if(d.coletado) continue;
        const cor=d.tipo==='fogo'?'#f97316':'#38bdf8';
        const pulso=1+Math.sin(tempo*0.1)*0.1;
        ctx.save();
        ctx.translate(d.x,d.y);
        ctx.scale(pulso,pulso);
        ctx.shadowColor=cor;
        ctx.shadowBlur=12;
        ctx.fillStyle=cor;
        ctx.beginPath();
        ctx.moveTo(0,-11);
        ctx.lineTo(8,0);
        ctx.lineTo(0,11);
        ctx.lineTo(-8,0);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle='rgba(255,255,255,0.6)';
        ctx.beginPath();
        ctx.moveTo(0,-6);
        ctx.lineTo(3,0);
        ctx.lineTo(0,3);
        ctx.lineTo(-2,0);
        ctx.closePath();
        ctx.fill();
        ctx.shadowBlur=0;
        ctx.restore();
      }

      // Saídas
      function desenharSaida(s, cor, corClara, emoji, ativo){
        ctx.fillStyle=ativo?corClara:'#1e293b';
        ctx.strokeStyle=cor;
        ctx.lineWidth=3;
        ctx.shadowColor=ativo?cor:'transparent';
        ctx.shadowBlur=ativo?20:0;
        ctx.beginPath();
        ctx.roundRect(s.x,s.y,s.w,s.h,6);
        ctx.fill();
        ctx.stroke();
        ctx.shadowBlur=0;
        // Interior
        ctx.fillStyle=ativo?cor:cor+'88';
        ctx.beginPath();
        ctx.roundRect(s.x+6,s.y+10,s.w-12,s.h-20,4);
        ctx.fill();
        ctx.font='18px serif';
        ctx.fillStyle='#fff';
        ctx.fillText(emoji, s.x+11, s.y+38);
      }
      desenharSaida(saidaFogo,'#f97316','#fdba74','🔥',fogoNaSaida);
      desenharSaida(saidaAgua,'#38bdf8','#7dd3fc','💧',aguaNaSaida);

      // Partículas
      for(const p of particulas){
        ctx.globalAlpha=Math.max(0,p.vida/40);
        ctx.fillStyle=p.cor;
        ctx.beginPath();
        ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
        ctx.fill();
      }
      ctx.globalAlpha=1;

      // Personagens
      desenharPersonagem(fogo,'fogo');
      desenharPersonagem(agua,'agua');

      // Avisos
      if(fogoNaSaida&&!aguaNaSaida){
        ctx.fillStyle='#fdba74';
        ctx.font='bold 13px sans-serif';
        ctx.shadowColor='#f97316';
        ctx.shadowBlur=6;
        ctx.fillText('Esperando Água...', saidaFogo.x-28, saidaFogo.y-10);
        ctx.shadowBlur=0;
      }
      if(aguaNaSaida&&!fogoNaSaida){
        ctx.fillStyle='#7dd3fc';
        ctx.font='bold 13px sans-serif';
        ctx.shadowColor='#38bdf8';
        ctx.shadowBlur=6;
        ctx.fillText('Esperando Fogo...', saidaAgua.x-28, saidaAgua.y-10);
        ctx.shadowBlur=0;
      }
    }

    function loop(){
      atualizar();
      desenhar();
      if(jogoAtivo) requestAnimationFrame(loop);
    }

    ctx.fillStyle='#0f172a';
    ctx.fillRect(0,0,W,H);
  </script>
